# ---------- Estágio 1: build do React (Node 18, versão original do projeto) ----------
FROM node:18.17.0-alpine AS build

WORKDIR /app

# Não baixa o binário do Cypress (usado só em testes e2e)
ENV CYPRESS_INSTALL_BINARY=0

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# O frontend chama ${REACT_APP_BACKEND_URL}/create e /guess/<id>.
# Usamos um caminho relativo: o próprio NGINX encaminha /api para o backend.
ARG REACT_APP_BACKEND_URL=/api
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}
RUN npm run build

# ---------- Estágio 2: NGINX servindo o build + proxy reverso ----------
FROM nginx:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80
